# URL do seu projeto Supabase (Frontend)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave publishable (anon) do Supabase.
# OBRIGATÓRIO em produção. Em dev, se ausente, o build usa fallback legível.
# Em build, o plugin `maskSupabaseKey` quebra esse valor em pedaços XOR/Base64
# e EMBUTE no bundle em formato não-literal (não aparece em buscas de string
# nem na aba Network do navegador). Veja README > "Modelo de Chaves".
VITE_SUPABASE_PUBLISHABLE_KEY=sua-chave-publica-aqui

# Chave usada para criptografar preferências locais (AES-256) antes do localStorage.
# AVISO: como o nome já entrega, `VITE_*` é embutida no bundle — use apenas
# para ofuscação/defesa em profundidade. Para segredos reais, use Edge Function.
VITE_STORAGE_ENCRYPTION_KEY=gere-uma-chave-longa-e-unica
